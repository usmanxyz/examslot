APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+psycopg://examslot_app:local-app-password@localhost:5434/examslot
MIGRATION_DATABASE_URL=postgresql+psycopg://examslot_owner:local-owner-password@localhost:5434/examslot
TEST_DATABASE_URL=postgresql+psycopg://examslot_owner:local-owner-password@localhost:5434/examslot_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

APP_TIMEZONE=Asia/Karachi
DEFAULT_EXAM_MINUTES=180
HASH_CONCURRENCY=4

SEED_INBOX=local-inbox@example.com
SEED_ADMIN_EMAIL=local-inbox+admin@example.com
SEED_ADMIN_PASSWORD=local-demo-admin-password
SEED_STUDENT_PASSWORD=local-demo-student-password
