APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://examslot_app:local-app-password@localhost:5434/examslot
MIGRATION_DATABASE_URL=postgresql+psycopg://examslot_owner:local-owner-password@localhost:5434/examslot
TEST_DATABASE_URL=postgresql+psycopg://examslot_owner:local-owner-password@localhost:5434/examslot_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

APP_TIMEZONE=Asia/Karachi
DEFAULT_EXAM_MINUTES=180
HASH_CONCURRENCY=4

JWT_SECRET=local-development-secret-replace-with-token-urlsafe-48
JWT_ISSUER=examslot-api
JWT_STUDENT_AUDIENCE=examslot-student
JWT_ADMIN_AUDIENCE=examslot-admin
STUDENT_TOKEN_MINUTES=60
ADMIN_TOKEN_MINUTES=30

EMAIL_BACKEND=memory
RESEND_API_KEY=
EMAIL_FROM=ExamSlot <no-reply@mail.solvirapk.com>
EMAIL_REPLY_TO=theusmanasghar@gmail.com
EMAIL_HOURLY_CAP=30
EMAIL_DAILY_CAP=90
EMAIL_RECIPIENT_ALLOWLIST=

SETUP_LINK_HOURS=24
RESET_LINK_MINUTES=60
RESET_EMAILS_PER_HOUR=3

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

RATE_LOGIN_LIMIT=30
RATE_LOGIN_WINDOW_SECONDS=900
RATE_PASSWORD_LIMIT=10
RATE_PASSWORD_WINDOW_SECONDS=900
RATE_REQUESTS_LIMIT=10
RATE_REQUESTS_WINDOW_SECONDS=3600
RATE_ADMIN_WRITE_LIMIT=120
RATE_ADMIN_WRITE_WINDOW_SECONDS=600
RATE_API_LIMIT=300
RATE_API_WINDOW_SECONDS=60

SEED_INBOX=local-inbox@example.com
SEED_ADMIN_EMAIL=local-inbox+admin@example.com
SEED_ADMIN_PASSWORD=local-demo-admin-password
SEED_STUDENT_PASSWORD=local-demo-student-password
